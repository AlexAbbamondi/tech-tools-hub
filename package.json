{
  "name": "tech-tools-hub",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "min:css": "node scripts/minify-css.js",
    "min:js": "node scripts/minify-js.js",
    "build": "npm-run-all min:css min:js",
    "watch:css": "chokidar \"assets/css/**/*.css\" --ignore \"assets/css/**/*.min.css\" -c \"npm run min:css\"",
    "watch:js": "chokidar \"assets/js/**/*.js\" --ignore \"assets/js/**/*.min.js\" -c \"npm run min:js\"",
    "watch": "npm-run-all --parallel watch:css watch:js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AlexAbbamondi/tech-tools-hub.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/AlexAbbamondi/tech-tools-hub/issues"
  },
  "homepage": "https://github.com/AlexAbbamondi/tech-tools-hub#readme",
  "devDependencies": {
    "chokidar-cli": "^3.0.0",
    "lightningcss-cli": "^1.32.0",
    "npm-run-all": "^4.1.5",
    "terser": "^5.47.1"
  }
}
